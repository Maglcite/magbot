[Unit]
Description=Stoat.chat AI Bot (Hermes ACP backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/stoat-bot/venv/bin/python /opt/stoat-bot/bot.py
Restart=on-failure
RestartSec=10
EnvironmentFile=/opt/stoat-bot/.env
WorkingDirectory=/opt/stoat-bot

# Hermes ACP bridge runtime configuration
Environment=HERMES_PY=/usr/local/lib/hermes-agent/venv/bin/python
Environment=BRIDGE_SCRIPT=/opt/stoat-bot/fembot_hermes_bridge.py
Environment=FEMBOT_HERMES_HOME=%h/.hermes/profiles/fembot
Environment=PROMPT_TIMEOUT=300
Environment=THINKING_MODE=off
Environment=BRIDGE_TIMEOUT=330

# Security hardening (relaxed: the Hermes bridge must write profile memory/sessions)
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=default.target
