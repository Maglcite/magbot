# Copy to .env (in the deployment: /opt/magbot/.env) and fill in.
# Never commit the real file. Keep it private: chmod 600 .env
# Settings that are not secrets live in config.toml, not here.
# The systemd unit loads this file itself; for a manual run, export it first.

# Required. The bot account's token (read by magbot and by the web UI).
STOAT_BOT_TOKEN=

# Required by the default provider. The name is set by [[llm.providers]].api_key_env.
OPENAI_API_KEY=

# Optional. Needed only when tools.search_backend = "brave".
BRAVE_API_KEY=

# Optional. Needed only when tools.image_base_url is set (image generation).
IMAGE_API_KEY=

# Optional. Path to config.toml. Default: ./config.toml in the working directory.
MAGBOT_CONFIG=/opt/magbot/config.toml

# Optional. Log level for python -m magbot: DEBUG, INFO, WARNING or ERROR.
MAGBOT_LOG_LEVEL=INFO

# Add one line per other provider key, e.g. LOCAL_API_KEY=, when a [[llm.providers]]
# entry names a different api_key_env. Local servers that need no key can leave it unset.
