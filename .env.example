# Copy to /opt/stoat-bot/.env and fill in. Never commit the real file.
STOAT_BOT_TOKEN=
# The bot account's own Stoat user id (used so it never gates itself)
STOAT_SELF_ID=
# Exact name#1234 tags, comma-separated
STOAT_ADMINS=
STOAT_SHELL_USERS=
# Public base URL that /opt/stoat-bot/www is served under
FILE_BASE_URL=https://files.example.com
# Name variants that count as addressing the bot
BOT_NAMES=magbot,mag bot,mag-bot
# Optional silent exclusions (tags / ids, comma-separated)
STOAT_NO_CONTEXT=
STOAT_NO_CONTEXT_IDS=
